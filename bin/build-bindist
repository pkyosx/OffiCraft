#!/usr/bin/env bash
# officraft — stage the prebuilt binaries + frozen MCP catalog for the
# single binary.
#
# bootstrap-here / the binary download routes / MCP tools/list serve three
# assets — ocwarden, ocagent and spec/mcp-catalog.json — EMBED-ONLY (assets.go +
# api_machines.go — no disk fallback, so a stale copy under the CWD can never
# shadow the embed the binary was built with). ⚠️ Only the catalog is a repo
# file; the two binaries are BUILT here from cli/ocwarden and cli/ocagent. This
# said "repo-file assets (bin/ocwarden, bin/ocagent, …)" and there is no
# bin/ocwarden and no bin/ocagent — never has been in this repo's history. A
# sentence like that exists so the next person does not have to go look. go:embed
# cannot reach outside the server module, so this stages them into
# server/ocserverd/bindist/ (gitignored except .gitkeep) before `go build` —
# the exact seedsdist pattern (bin/build-seedsdist). WITHOUT this staging the
# binary still builds but serves an EMPTY bindist embed (tools/list, the binary
# downloads, and bootstrap-here all fail).
#
# ocwarden/ocagent/officraft are built FRESH here for every platform in
# bin/lib/member-platforms.sh, one directory each (bindist/<os>-<arch>/), so a member
# machine of any of those platforms joins and self-updates from its own server.
# Chicken-and-egg ordering: this MUST run before the ocserverd build that embeds
# it.
#
#   bash bin/build-bindist            # stage the binaries + catalog
#   (cd server/ocserverd && go build) # then bakes them into the binary
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# 🔴 RESOLVED BEFORE ANYTHING IS DELETED. The wipe below removes a TRACKED file
# (server/ocserverd/bindist/.gitkeep), so a sha check placed after it left the
# working tree with that file deleted and only an error message to explain it.
# Nothing destructive happens until we know this build can name itself.
OCAGENT_SHA="${OCAGENT_SHA:-$(git -C "$ROOT" rev-parse --short HEAD 2>/dev/null || true)}"
# Trim before testing: `-z` is false for " ", and a whitespace stamp links in
# cleanly, produces a binary that passes every text check, and prints no segment
# at runtime — the unstamped fleet again, wearing a value.
OCAGENT_SHA="$(printf '%s' "$OCAGENT_SHA" | tr -d '[:space:]')"
if [[ -z "$OCAGENT_SHA" ]]; then
  echo "build-bindist: cannot resolve a git sha for the ocagent stamp (is this a" >&2
  echo "  git checkout? a tarball or 'git archive' tree has no .git). Refusing to" >&2
  echo "  build an ocagent that cannot say which build it is: an unstamped listener" >&2
  echo "  is indistinguishable from a dev build, which is the false negative this" >&2
  echo "  stamp exists to remove. Set OCAGENT_SHA explicitly to build anyway." >&2
  exit 1
fi

# The server's own platform is always carried (bootstrap-here installs on the
# server host itself) and is built LAST, so cli/ocwarden/anchordist ends up
# holding this host's anchor for a local `go build` / `go test` of ocwarden.
HOST_PLATFORM="$(go env GOOS)/$(go env GOARCH)"
. "$ROOT/bin/lib/member-platforms.sh"
PLATFORMS=()
for platform in $OC_MEMBER_PLATFORMS; do
  [[ "$platform" == "$HOST_PLATFORM" ]] || PLATFORMS+=("$platform")
done
PLATFORMS+=("$HOST_PLATFORM")

BINDIST="$ROOT/server/ocserverd/bindist"
rm -rf "$BINDIST"
mkdir -p "$BINDIST"
ANCHORDIST="$ROOT/cli/ocwarden/anchordist"
mkdir -p "$ANCHORDIST"

for platform in "${PLATFORMS[@]}"; do
  goos="${platform%/*}"
  goarch="${platform#*/}"
  out="$BINDIST/$goos-$goarch"
  mkdir -p "$out"
  # Linux binaries are static so one build runs on any distro. darwin keeps Go's
  # default: the committed darwin anchor was built that way, and CGO_ENABLED=0
  # changes its bytes.
  goenv=(GOOS="$goos" GOARCH="$goarch")
  [[ "$goos" == linux ]] && goenv+=(CGO_ENABLED=0)

  # 🔴 Only ocagent carries its build SHA: a long-lived listener keeps the image it
  # started with, and the stamp is the only way to tell which build it runs. No
  # SHA ⇒ the script already died above; never fall back to an empty stamp.
  # ⚠️ Never stamp officraft or ocwarden: officraft's bytes are its identity and
  # ship in every tarball, and check-officraft-dist cannot see a stamp added here —
  # only bin/tests/agent-build-sha-guard.sh does.
  (cd "$ROOT/cli/ocagent" && env "${goenv[@]}" \
    go build -ldflags="-s -w -X main.buildSHA=$OCAGENT_SHA" -o "$out/ocagent" ./...)

  # The anchor is staged BEFORE ocwarden into cli/ocwarden/anchordist, because
  # ocwarden embeds it: the cockpit's one-liner downloads ocwarden alone, and
  # `ocwarden install` refuses without an anchor. Staging both places from ONE
  # file is what keeps the embedded copy and the tarball copy byte-identical.
  #
  # The darwin anchor is the committed dist/officraft/officraft itself: those
  # bytes ARE the TCC identity, and a different copy means a separate
  # authorization prompt on every Mac. Other platforms have no TCC and no
  # committed copy; theirs is built from source with dist/officraft/BUILD.md's
  # flags, so it is reproducible like the darwin one.
  if [[ "$platform" == darwin/arm64 ]]; then
    cp "$ROOT/dist/officraft/officraft" "$out/officraft"
  else
    (cd "$ROOT/cli/officraft" && env "${goenv[@]}" \
      go build -trimpath -buildvcs=false -ldflags="-s -w" -o "$out/officraft" ./...)
  fi
  cp "$out/officraft" "$ANCHORDIST/officraft"

  # ocwarden LAST, so its embed picks up the anchor staged just above.
  (cd "$ROOT/cli/ocwarden" && env "${goenv[@]}" \
    go build -ldflags="-s -w" -o "$out/ocwarden" ./...)

  # A wrong-platform binary builds cleanly and is only refused at release time;
  # a member machine that downloads one cannot run it.
  for bin in ocagent officraft ocwarden; do
    mismatch="$(binary_platform_mismatch "$out/$bin" "$goos-$goarch")"
    if [[ -n "$mismatch" ]]; then
      echo "build-bindist: bindist/$goos-$goarch/$bin is not a $goos/$goarch executable (file says: $mismatch)" >&2
      exit 1
    fi
  done
done
touch "$ANCHORDIST/.gitkeep"
# THE FLEET-SERVED BINARIES ARE NOT CODE-SIGNED, and this script has no way to
# sign them (T-0398, owner 2026-07-31). They carry whatever `go build` produces —
# an adhoc signature with a fresh cdhash per build. The signing machinery is
# DELETED rather than switched off, escape hatch included, so this script needs no
# keychain and concurrent bin/ci.sh runs cannot contend for one. ⚠️ This is NOT
# the same subject as the TCC identity anchor above: the anchor is recognised by
# its BYTES (which is why it is byte-pinned and never overwritten), and that
# mechanism never depended on a signing identity.
cp "$ROOT/spec/mcp-catalog.json" "$BINDIST/"
touch "$BINDIST/.gitkeep"
echo "[build-bindist] staged ocwarden (anchor embedded) + ocagent + officraft for ${PLATFORMS[*]} + mcp-catalog.json → server/ocserverd/bindist"
