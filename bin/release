#!/usr/bin/env bash
# officraft — THE release command. Two subcommands, one job each:
#
#   bin/release publish --beta <tag> --target <sha> [--dry-run] [--no-settle]
#   bin/release promote <tag>                       [--dry-run]
#
# WHY THIS FILE HAS SUBCOMMANDS (T-588c). The old form was `bin/release <tag>`:
# it built from whatever the CURRENT worktree's HEAD happened to be, packaged
# three files, and then PRINTED a `gh release create` line for a human to copy.
# Every interesting failure lived in the gap between those two halves —
#   * the tag says v0.1.0 but the bytes came from an unrelated branch tip,
#     because "clean tree" was checked and "which commit" never was;
#   * one of the three assets fails to upload and the release exists ANYWAY, half
#     populated, with an install one-liner that 404s;
#   * the release is created against the wrong targetCommitish, or lands as a
#     draft, so nothing that reads GitHub Releases (the in-product update check)
#     can see it;
#   * the artifacts are fine, the release is fine, and the running station never
#     actually moves onto the new build — nobody looked.
# — and a printed command verifies nothing. So: publish owns the whole arc and
# READS BACK what GitHub actually stored, and promote owns the beta->final flip
# WITHOUT rebuilding anything.
#
# ── publish ─────────────────────────────────────────────────────────────────
#   1. gates      — tag shape v*, --target resolves to a real commit, darwin/arm64.
#   2. staging    — a THROWAWAY detached worktree at exactly <sha> (git worktree
#                   add --detach). Not "the current tree is clean": the bytes come
#                   from the commit you named, and the worktree is verified to be
#                   at that commit and pristine before anything is built. The
#                   invoking worktree is never built in and never mutated.
#   2b. CI GATE   — the verdict of the GitHub Actions round THIS COMMIT already
#                   went through, read back from the Actions API: that round's
#                   head_sha must be <sha> exactly, and all eleven gate jobs must
#                   be present with conclusion exactly "success". Evidence goes to
#                   a per-run directory under the output dir. Not green ⇒ nothing
#                   is built, packaged, uploaded or tagged. Publish no longer runs
#                   CI itself (owner rulings rc-56fecb4d5aa3 / rc-538d9ca1ad1d) —
#                   see run_release_ci for why that is a WIDER gate, not a weaker
#                   one, and for the one path (a hand-run publish) that carries no
#                   verdict at all.
#   3. build      — OC_APP_VERSION=<tag> bin/build inside the staging worktree:
#                   frontend SPA (VITE_USE_MOCK=false) + seeds + fresh
#                   ocwarden/ocagent (bindist) all EMBEDDED into .deploy/ocserverd,
#                   with appVersion stamped to <tag> and buildSHA/buildTime to
#                   <sha> (so /api/version self-identifies the release).
#   4. package    — dist/release/officraft-<tag>-darwin-arm64.tar.gz (ocserverd,
#                   ocwarden, ocagent, officraft, install.sh, LICENSE, README.md)
#                   — officraft is the TCC identity anchor launchd starts instead
#                   of ocwarden; install.sh refuses without it. plus
#                   install.sh as its OWN asset (the documented curl|bash
#                   one-liner downloads that file: docs/guide/install.md) plus
#                   checksums.txt (sha256 of the tarball + install.sh).
#   5. VERIFY THE ARTIFACTS before anything is uploaded — member list, mach-o
#                   arm64-ness, the version/sha actually linked into ocserverd
#                   (`go version -m`, i.e. the linker flags, not a hopeful grep),
#                   and `shasum -c` against the checksums file we are about to
#                   publish.
#   6. upload     — ONE `gh release create --prerelease --target <sha>` carrying
#                   all three assets. One call, so there is no window where the
#                   release exists with a partial asset set.
#   7. READ BACK  — ask GitHub what it stored and require: every expected asset
#                   present AND state=uploaded, targetCommitish == <sha>,
#                   isDraft == false, isPrerelease == true. Anything else exits
#                   non-zero NAMING the failed item.
#                   The shape of that payload is MEASURED, not assumed — see the
#                   note above verify_stored_release.
#   8. SETTLE     — poll the live station until GET /api/version reports a git_sha
#                   that matches <sha> AND GET /api/health answers ok.
#                   ⚠️ PUBLISH DOES NOT TRIGGER THE UPGRADE. This step only
#                   OBSERVES one. The station picks a new release up by itself
#                   because auto_update is enabled on the owner's account, and a
#                   PRERELEASE does qualify: measured 2026-07-26, the station moved
#                   onto v0.5.38 (isPrerelease=true) about 2-3 minutes after the
#                   release was created, and /api/version's git_sha reconciled. So
#                   waiting here is the correct operational expectation, not a
#                   design gap. But if auto_update is ever switched OFF on that
#                   account, this step will fail — CORRECTLY, and for a reason
#                   that has nothing to do with the release itself. That is why
#                   the timeout message names the unmet item explicitly instead of
#                   just saying the publish failed.
#
# ── WHY --no-settle EXISTS (owner ruling 1, 2026-08-05; T-9fe3) ──────────────
# Step 8 above waits for A STATION — in practice the owner's own machine — to
# pick the release up. The owner ruled that whether any station upgraded is NOT a
# success condition for publishing: OffiCraft is software people self-host, not a
# SaaS this repo operates, so "did the operator's server move onto it" is a fact
# about somebody's laptop, not about the release. It became a live problem when
# publishing moved onto an unattended runner (the auto-beta job in
# .github/workflows/ci.yml): that runner cannot reach a private station at all, so
# step 8 would fail every automated publish for a reason that says nothing about
# the artifacts.
#
# So --no-settle is an EXPLICIT, per-invocation opt-out and nothing else:
#   * the DEFAULT is unchanged — a human publishing by hand still waits for the
#     station, and still fails if it never arrives. That wait is worth keeping
#     for the operator who IS standing in front of that station.
#   * it is a flag, not an env var and not a changed default, because the caller
#     that declines to check has to say so where anyone reading the command can
#     see it.
#   * when it is set, the run says WHY it is not checking, and the final success
#     line does NOT claim the station is on this commit — a publish that skipped
#     the check must not print anything a reader could mistake for having made it.
# It does NOT touch step 7: what GitHub stored is still read back and still fatal.
#
# --dry-run stops after step 5 and prints the exact upload command it would have
# run. That is the shape used to rehearse a release, because steps 6-8 mutate
# GitHub and must only ever be run for real by the person actually shipping. It
# DOES run the CI gate — a rehearsal that skipped the gate would not rehearse the
# step most likely to stop the release.
#
# ── promote ─────────────────────────────────────────────────────────────────
# Turns an EXISTING, ALREADY-VERIFIED prerelease into the final release. It
# rebuilds NOTHING — the bytes people have been testing are the bytes that ship,
# which is the entire point of a beta. It first re-verifies the prerelease
# (exists, not a draft, is a prerelease, expected asset set, all uploaded, a
# targetCommitish on record), then flips it, then READS BACK that the flip landed
# and that the asset set and target commit are the same ones it verified. An
# asset set that changed under promote means someone re-uploaded behind our back,
# and that is a failure, not a warning.
#
# ── RELEASES ARE NOT CODE-SIGNED, AND THERE IS NO OPTION TO SIGN ────────────
# (owner ruling, T-0398, 2026-07-31: take the whole thing out, INCLUDING the
# manual escape hatch.) A published release carries whatever `go build`
# produced — an adhoc signature whose cdhash changes every build. There is no
# `--sign` flag, no OC_CODESIGN_* knob, no bin/codesign-artifact and no
# bin/build-release: that machinery is DELETED, not gated off, so no publish path
# can reach the login keychain. If signing is ever wanted back it comes back as a
# decision with its own ticket — do not re-add a flag here because a caller
# looked like it wanted one.
#
# The repo tree stays ZERO-BINARY: artifacts land in dist/release/ (gitignored),
# nothing is committed, and the staging worktree is removed on exit.
#
# knobs (env) — all defaulted; the overrides exist so bin/tests/release-guard.sh
# can drive the real control flow hermetically:
#   OC_RELEASE_SRC        git repo the staging worktree is cut from (default: this repo)
#   OC_RELEASE_OUT        artifact output dir (default: <repo>/dist/release)
#   OC_RELEASE_GH_REPO    GitHub repo for gh calls (default: pkyosx/OffiCraft)
#   OC_RELEASE_SITE       station base URL polled in step 8 (default: http://127.0.0.1:7755)
#   OC_RELEASE_SETTLE_TRIES / OC_RELEASE_SETTLE_SLEEP   step-8 polling budget
#   OC_RELEASE_LATEST_TRIES / OC_RELEASE_LATEST_SLEEP   isLatest read-back retry
#                          budget (verify_stored_release), same shape as
#                          settle_station's poll-retry — GitHub's own docs do
#                          not promise --latest is visible on /releases/latest
#                          the instant `gh release edit` returns.
#
# There is deliberately NO "override the build command" knob, and none that can
# soften the CI gate. Step 3 runs `$STAGE/bin/build` — a path INSIDE the staging
# worktree — so OC_RELEASE_SRC pointing at a small fixture repo carrying its own
# bin/build drives steps 3-8 hermetically against the REAL invocation. Step 2b is
# hermetic through a different door: it is pure HTTP, so a PATH-shimmed `curl`
# drives it without bin/release knowing, and OC_RELEASE_GH_REPO already decides
# which repo is asked. The two knobs it does read — GITHUB_RUN_ID and
# GITHUB_API_URL — are GitHub's own, set by the runner, not ours.
#
# ── SOURCEABLE ──────────────────────────────────────────────────────────────
# Dispatch is guarded by "am I being executed", so bin/tests/release-guard.sh can
# `source` this file and unit-test verify_stored_release / verify_artifacts /
# settle_station DIRECTLY. That matters more than it looks: the alternative is a
# guard that re-implements the read-back rules, which would then pass while the
# real ones rot. The tests must bind to THESE functions, not to copies of them.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

SRC="${OC_RELEASE_SRC:-$ROOT}"
OUT="${OC_RELEASE_OUT:-$ROOT/dist/release}"
GH_REPO="${OC_RELEASE_GH_REPO:-pkyosx/OffiCraft}"
SITE="${OC_RELEASE_SITE:-http://127.0.0.1:7755}"
SETTLE_TRIES="${OC_RELEASE_SETTLE_TRIES:-60}"
SETTLE_SLEEP="${OC_RELEASE_SETTLE_SLEEP:-5}"
LATEST_TRIES="${OC_RELEASE_LATEST_TRIES:-3}"
LATEST_SLEEP="${OC_RELEASE_LATEST_SLEEP:-2}"

say()  { echo "[release] $*"; }
die()  { echo "[release] FATAL: $*" >&2; exit "${2:-1}"; }
# fail_item — every VERIFICATION failure funnels here so it always names the item
# that failed. The DoD for this command is "any check that does not pass exits
# non-zero and says which one"; letting each site invent its own wording is how
# that promise quietly stops being true.
fail_item() { echo "[release] VERIFY-FAILED [$1]: $2" >&2; exit 6; }

usage() {
  cat >&2 <<'USAGE'
usage:
  bin/release publish --beta <tag> --target <sha> [--dry-run] [--no-settle]
  bin/release promote <tag> [--dry-run]

  publish   build <tag> from a clean staging worktree at <sha>, verify the
            artifacts, upload them as a PRERELEASE in one call, read back what
            GitHub stored, then wait for the live station to be on <sha>.
  promote   flip an existing, verified prerelease to the final release.
            Rebuilds nothing. Reads back that the flip landed.

  --dry-run publish: stop after artifact verification and print the upload
            command. promote: verify the prerelease and print the flip command.
  --no-settle
            publish: do NOT wait for a station to upgrade (step 8). Whether a
            self-hosted station moved is not a success condition for a release
            (owner ruling, 2026-08-05); an unattended runner cannot reach one at
            all. Everything else, including the read-back of what GitHub stored,
            is unchanged.
USAGE
  exit 2
}

require_tag_shape() {
  [[ "$1" =~ ^v[0-9][0-9A-Za-z.-]*$ ]] \
    || die "tag '$1' does not look like a version tag (v...)." 2
}

# ── artifact naming, in ONE place ────────────────────────────────────────────
# publish builds these and promote re-verifies them, so the expected asset set
# must have exactly one definition. Drift between "what we upload" and "what we
# check for" is otherwise invisible.
asset_names() { # asset_names <tag>
  printf '%s\n' "officraft-$1-darwin-arm64.tar.gz" "install.sh" "checksums.txt"
}

# ═══════════════════════════════════════════════════════════════════════════
# publish
# ═══════════════════════════════════════════════════════════════════════════
cmd_publish() {
  local TAG="" TARGET="" DRY=0 NO_SETTLE=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --beta)       TAG="${2:-}";    shift 2 ;;
      --target)     TARGET="${2:-}"; shift 2 ;;
      --dry-run)    DRY=1;           shift ;;
      --no-settle)  NO_SETTLE=1;     shift ;;
      *) echo "[release] unknown publish argument: $1" >&2; usage ;;
    esac
  done
  [[ -n "$TAG"    ]] || { echo "[release] publish needs --beta <tag>" >&2; usage; }
  [[ -n "$TARGET" ]] || { echo "[release] publish needs --target <sha>" >&2; usage; }
  require_tag_shape "$TAG"

  # 1. gates. --target is resolved HERE, against the source repo, so a typo dies
  #    before a build rather than after an upload.
  local SHA SHORT
  SHA="$(git -C "$SRC" rev-parse --verify "${TARGET}^{commit}" 2>/dev/null)" \
    || die "--target '$TARGET' does not resolve to a commit in $SRC." 2
  SHORT="$(git -C "$SRC" rev-parse --short "$SHA")"
  if [[ "$(uname -s)" != "Darwin" || "$(uname -m)" != "arm64" ]]; then
    die "release builds run on darwin/arm64 (the asset is darwin-arm64)."
  fi

  local NAME="officraft-$TAG-darwin-arm64"
  say "publish $TAG (prerelease) from $SHORT ($SHA)"

  # 2. staging worktree at exactly $SHA. Detached, throwaway, removed on exit.
  #    `git worktree add` refuses to reuse an existing path, so leftovers are a
  #    hard error rather than a silent build against stale bytes.
  local STAGE
  STAGE="$(mktemp -d -t oc-release-stage.XXXXXX)"
  rmdir "$STAGE"
  # shellcheck disable=SC2064
  trap "git -C '$SRC' worktree remove --force '$STAGE' >/dev/null 2>&1 || true; git -C '$SRC' worktree prune >/dev/null 2>&1 || true" EXIT
  say "staging worktree: $STAGE (detached at $SHORT)"
  git -C "$SRC" worktree add --detach "$STAGE" "$SHA" >/dev/null \
    || die "could not create the staging worktree at $SHA."
  local STAGE_SHA
  STAGE_SHA="$(git -C "$STAGE" rev-parse HEAD)"
  [[ "$STAGE_SHA" == "$SHA" ]] \
    || fail_item staging-commit "staging worktree is at $STAGE_SHA, not the requested $SHA."
  [[ -z "$(git -C "$STAGE" status --porcelain)" ]] \
    || fail_item staging-clean "staging worktree is not pristine at $SHORT (a fresh checkout must be clean)."

  # 2b. THE RELEASE GATE — this commit's own CI verdict, read from GitHub.
  #     Deliberately placed HERE: after the staging worktree has been proven to
  #     be at $SHA and pristine, and BEFORE anything is built, packaged, uploaded
  #     or tagged. See run_release_ci for why GitHub's round and not a local one.
  run_release_ci "$SHA" "$SHORT"

  # 3. build. bin/build owns the embed ordering (SPA -> webdist, seeds ->
  #    seedsdist, fresh ocwarden/ocagent -> bindist, then the ocserverd build
  #    that embeds all three). There is exactly ONE builder — no signed variant
  #    (T-0398).
  local BUILDER="bin/build"
  say "build: OC_APP_VERSION=$TAG bash $BUILDER (in the staging worktree)"
  ( cd "$STAGE" && OC_APP_VERSION="$TAG" bash "$STAGE/$BUILDER" ) \
    || die "the release build failed — nothing was uploaded."

  # 4. package. bindist still holds the exact ocwarden/ocagent builds that were
  #    embedded (bin/build leaves them staged on purpose) — ship those same bytes
  #    rather than rebuilding, so package == embedded.
  mkdir -p "$OUT"
  local PKG="$STAGE/.release-pkg/$NAME"
  mkdir -p "$PKG"
  cp "$STAGE/.deploy/ocserverd"                     "$PKG/ocserverd"
  cp "$STAGE/server/ocserverd/bindist/ocwarden"     "$PKG/ocwarden"
  cp "$STAGE/server/ocserverd/bindist/ocagent"      "$PKG/ocagent"
  cp "$STAGE/server/ocserverd/bindist/officraft"    "$PKG/officraft"
  cp "$STAGE/bin/install.sh"                        "$PKG/install.sh"
  cp "$STAGE/LICENSE"                               "$PKG/LICENSE"
  chmod +x "$PKG/ocserverd" "$PKG/ocwarden" "$PKG/ocagent" "$PKG/officraft" "$PKG/install.sh"
  write_package_readme "$PKG/README.md" "$TAG" "$SHORT"
  tar -C "$STAGE/.release-pkg" -czf "$OUT/$NAME.tar.gz" "$NAME"
  # install.sh doubles as a standalone release asset (the documented curl|bash
  # bootstrap downloads THIS file) — publish the SAME bytes that went in the tarball.
  cp "$PKG/install.sh" "$OUT/install.sh"
  chmod +x "$OUT/install.sh"
  ( cd "$OUT" && shasum -a 256 "$NAME.tar.gz" install.sh > checksums.txt )

  # 5. verify the artifacts BEFORE any upload.
  verify_artifacts "$TAG" "$SHA" "$SHORT" "$NAME"

  local -a ASSETS=()
  local a
  while IFS= read -r a; do ASSETS+=("$OUT/$a"); done < <(asset_names "$TAG")

  if [[ "$DRY" == 1 ]]; then
    say "DRY RUN — artifacts verified, NOTHING uploaded. The upload step would be:"
    say "  gh release create $TAG --repo $GH_REPO --prerelease --target $SHA \\"
    say "    --title \"OffiCraft $TAG\" --notes \"...\" ${ASSETS[*]}"
    if [[ "$NO_SETTLE" == 1 ]]; then
      say "then: read back the stored release. NO station check (--no-settle)."
    else
      say "then: read back the stored release, then wait for $SITE/api/version git_sha == $SHORT"
    fi
    return 0
  fi

  # 6. upload — ONE call with all assets, so no partial release can exist.
  say "upload: one gh release create with ${#ASSETS[@]} assets"
  gh release create "$TAG" --repo "$GH_REPO" --prerelease --target "$SHA" \
    --title "OffiCraft $TAG" \
    --notes "OffiCraft $TAG (darwin-arm64) — built from $SHORT. Install: see install.sh." \
    "${ASSETS[@]}" \
    || die "gh release create failed — check GitHub for a partially created release before retrying."

  # 7. read back what GitHub actually stored. A beta is never "Latest" — GitHub
  #    only considers non-prerelease, non-draft releases for that title — so
  #    isLatest is enforced false here too, not left unchecked.
  verify_stored_release "$TAG" "$SHA" prerelease false >/dev/null

  # 8. wait for the live station to actually be on this commit — unless the
  #    caller explicitly declined to check (see --no-settle in the header).
  if [[ "$NO_SETTLE" == 1 ]]; then
    say "settle: DELIBERATELY NOT CHECKED (--no-settle). OffiCraft is self-hosted"
    say "  software, so whether any station upgraded to $SHORT is not a success"
    say "  condition for this release (owner ruling, 2026-08-05) — and an"
    say "  unattended runner cannot reach a private station to ask."
    say "published: $TAG (prerelease) BUILT FROM $SHORT — the release and its assets are verified; NO station was checked"
  else
    settle_station "$SHA" "$SHORT"
    say "published and verified: $TAG (prerelease) on $SHORT"
  fi
}

# ═══════════════════════════════════════════════════════════════════════════
# promote
# ═══════════════════════════════════════════════════════════════════════════
cmd_promote() {
  local TAG="" DRY=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) DRY=1; shift ;;
      -*) echo "[release] unknown promote argument: $1" >&2; usage ;;
      *) [[ -z "$TAG" ]] || { echo "[release] promote takes exactly one tag" >&2; usage; }
         TAG="$1"; shift ;;
    esac
  done
  [[ -n "$TAG" ]] || { echo "[release] promote needs a tag" >&2; usage; }
  require_tag_shape "$TAG"
  say "promote $TAG: existing prerelease -> final release (NO rebuild)"

  # Pre-flip verification: it must ALREADY be the thing we are allowed to promote.
  # A beta is never GitHub's "latest" (only non-prerelease releases are eligible),
  # so that is enforced false here too rather than left unchecked.
  local BEFORE BEFORE_TARGET BEFORE_FINGERPRINT
  BEFORE="$(verify_stored_release "$TAG" "" prerelease false)"
  BEFORE_TARGET="$(printf '%s\n' "$BEFORE" | sed -n '1p')"
  BEFORE_FINGERPRINT="$(printf '%s\n' "$BEFORE" | sed -n '3,$p')"
  say "  verified prerelease on targetCommitish $BEFORE_TARGET"

  if [[ "$DRY" == 1 ]]; then
    say "DRY RUN — prerelease verified, NOTHING flipped. The flip would be:"
    say "  gh release edit $TAG --repo $GH_REPO --prerelease=false --draft=false --latest=true"
    return 0
  fi

  gh release edit "$TAG" --repo "$GH_REPO" --prerelease=false --draft=false --latest=true \
    || die "gh release edit failed — $TAG was NOT promoted."

  # Read back: the flip landed, AND nothing else moved. Passing $BEFORE_TARGET as
  # the EXPECTED target is what pins the commit — a target that moved under the
  # flip comes back as VERIFY-FAILED [release-target] naming both values, from
  # inside the read-back. There is deliberately no second `AFTER_TARGET !=
  # BEFORE_TARGET` comparison out here: it would be unreachable (the read-back
  # cannot succeed AND return a different target), and an unreachable check reads
  # like protection while providing none.
  #
  # `final true` for the isLatest arg is the whole point of this ticket: promote
  # existing only to flip prerelease/draft, so a GitHub API hiccup (or a
  # protected-branch/permissions quirk) could silently leave --latest not
  # applied, and NOTHING would ever say so. Passing "true" makes this read-back
  # itself fail_item (exit 6, item "release-latest") when isLatest didn't land,
  # instead of promote reporting success on a release nothing points update
  # checks at.
  local AFTER AFTER_FINGERPRINT
  AFTER="$(verify_stored_release "$TAG" "$BEFORE_TARGET" final true)"
  AFTER_FINGERPRINT="$(printf '%s\n' "$AFTER" | sed -n '3,$p')"
  # An asset set that changed under a metadata-only flip means somebody
  # re-uploaded behind us; the bytes people tested are then NOT the bytes that
  # ship, which is the one thing promote exists to guarantee.
  [[ "$AFTER_FINGERPRINT" == "$BEFORE_FINGERPRINT" ]] \
    || fail_item promote-assets "the asset set changed during promote (name/size differ) — the promoted bytes are not the tested bytes."
  say "promoted and verified: $TAG is now the final release on $BEFORE_TARGET, and GitHub confirms it is Latest"
}

# ═══════════════════════════════════════════════════════════════════════════
# verification helpers
# ═══════════════════════════════════════════════════════════════════════════

# The eleven jobs that MUST be green for a commit to be shippable. This list is
# `auto-beta`'s own `needs:` in .github/workflows/ci.yml, verbatim — the gate set
# that workflow already declares, transcribed here because the release command
# has to be able to state what it requires without trusting the very file whose
# verdict it is reading.
#
# 🔴 macos-e2e IS IN THIS LIST AND HAS NO LOCAL EQUIVALENT. bin/ci.sh's 29
# targets do not include it: it is the real-browser end-to-end round, the single
# check on the whole line that exercises the product as a user meets it. The
# previous gate — a local `bin/ci.sh` — therefore could NOT see it. Reading
# GitHub's verdict is what brought it inside the gate at all, which is why this
# change WIDENS coverage rather than narrowing it. Anyone dropping macos-e2e from
# here (or from auto-beta's needs) is quietly removing the only behavioural
# check; bin/tests/release-guard.sh case G2b reddens if they do.
REQUIRED_CI_JOBS="go-checks
frontend-checks
frontend-ct
drift-checks
contract-guards
conformance
hygiene
bin-guards
tcc-anchor
e2e-isolation-guard
macos-e2e"

# run_release_ci <sha> <short> — THE release gate (T-b65e; rebuilt on GitHub's
# own verdict by T-7e6c).
#
# WHY THIS EXISTS. Merging was deliberately loosened (cloud gate green ⇒ press
# it); the real gate moved HERE, to publish time. That makes this the ONLY
# behavioural verification a beta gets, because a prerelease is picked up by the
# station's own auto_update and goes live by itself — there is no second door
# downstream. Before the gate existed, `bin/release` verified that the package
# was well-formed, not that the software worked.
#
# WHAT CHANGED, AND WHAT DID NOT. Until T-7e6c this function STARTED ITS OWN full
# `bin/ci.sh` inside the staging worktree and judged that run's log. It now reads
# the verdict of the GitHub Actions round the commit has ALREADY been through.
# The owner ruled that swap on card rc-56fecb4d5aa3. The gate is not removed and
# not softened — the EVIDENCE moved, and it is a superset of what the local round
# could produce:
#
#   * COVERAGE GOES UP, measurably. macos-e2e is not in `bin/ci.sh`'s round at
#     all — the real-browser e2e round only ever existed as a GitHub job. (How
#     many targets that round has is deliberately not written here: it is
#     `grep -cvE '^\s*(#|$)' bin/lib/ci-round.txt`, and a number copied into
#     prose goes stale without anything turning red.) So the old gate ran a round that structurally COULD NOT include the
#     one check that exercises real behaviour, while calling itself "the only
#     behavioural verification". Reading the round fixes that.
#   * It is the same code, on the same commit, on the same runner image — and it
#     is the round whose green is what let the commit reach main in the first
#     place. A second local run of the same targets was never independent
#     evidence; it was the same evidence, paid for twice, minus macos-e2e.
#   * The failure mode the old design feared — "a green run that happened on this
#     machine at some point" — is closed by BINDING, not by re-running. See below.
#
# WHY BELIEVING THAT ROUND IS SAFE — THE BINDING. A verdict is only evidence if
# it is provably about THIS commit, so nothing here is taken on trust:
#   * the round is addressed by GITHUB_RUN_ID, which is THIS process's own run —
#     not a search for "some green run on this sha", which is what would let a
#     stale or re-run attempt certify a tree it never saw;
#   * that run's `head_sha` is compared BYTE FOR BYTE with the --target sha the
#     staging worktree was just proven to be at. A green round for another commit
#     is refused, and that is the rule the whole design rests on;
#   * the jobs are read from `/actions/runs/<id>/jobs`, which is bound to that run
#     by construction. (Check-runs-by-sha was the alternative and was rejected on
#     measurement: a check-run object carries no run_id at all, so "does this
#     belong to my round" could only be answered by parsing details_url strings.)
#   * NO `filter` parameter is passed. The API default is filter=latest, which is
#     exactly what excludes a re-run's superseded earlier attempt; `filter=all`
#     would let a stale green attempt outvote a red re-run.
#
# WHY IT CANNOT BE SATISFIED CHEAPLY. Two independent requirements, and each one
# alone is known to be forgeable:
#   * EVERY name in REQUIRED_CI_JOBS must be PRESENT. A job that never ran
#     produces no entry at all — add a `paths-ignore`, drop a `needs` edge, rename
#     a job, and "everything I can see is green" is perfectly true of a round that
#     checked nothing. Absence is the failure that looks like success.
#   * every one of them must have `conclusion == "success"`, compared LITERALLY.
#     🔴 Not `!= "failure"`. Measured over the last 200 runs of this workflow the
#     conclusions were success 168, cancelled 23, failure 7, action_required 2 —
#     so a not-failure test waves through three outcomes that actually happen,
#     plus `skipped`, which is what every gate job reports when an earlier one
#     went red, and `null`, which is what a job still running reports.
# Everything else fails CLOSED: an unreadable, non-200, unparseable or truncated
# answer is not permission to ship. Evidence (both payloads) lands in a PER-RUN
# unique directory whose creation is `mkdir` without -p, so a name collision is a
# hard error rather than a run quietly adopting somebody else's verdict.
#
# CREDENTIALS: TOKEN WHEN THERE IS ONE, ANONYMOUS WHEN THERE IS NOT.
# This started out unconditionally anonymous, on the measurement that a public
# repo answers 200 to an unauthenticated request on both endpoints. That
# measurement was taken on a DEVELOPER MACHINE, whose egress IP is ours alone —
# and GitHub's anonymous quota is 60 requests/hour PER IP. A GitHub-hosted runner
# does not have an IP of its own in that sense, so "anonymous works" was never
# established for the one environment that actually ships releases. The failure
# there is loud (fail closed ⇒ no release) but it is loud for EVERY release: an
# outage of the shipping path, not a false green.
#
# So the request authenticates whenever a token is reachable — GITHUB_TOKEN (the
# runner exports it) or GH_TOKEN (what the auto-beta step already sets) — and
# falls back to anonymous when neither is set, which is what keeps a hand-run
# `bin/release` working on a laptop with no credentials. ⚠️ `auto-beta` must
# therefore declare `actions: read` ALONGSIDE `contents: write`: a job-level
# permissions block REPLACES the set wholesale, so without that key `actions` is
# `none` and the token is worse than no token at all.
#
# THE VERDICT RULES ARE IDENTICAL ON BOTH PATHS — binding, roll-call, literal
# "success". The credential decides how the request is made, never how strict the
# answer has to be. bin/tests/release-guard.sh G8b2/G8b3 assert that directly.
#
# 🔴 A TOKEN THAT IS REJECTED (401/403) FAILS CLOSED. It does NOT retry
# anonymously, and that is a decision, not an omission:
#   * a token that cannot read the run means the gate's own plumbing is broken
#     (the workflow grants `actions: read` precisely so it can), and the honest
#     answer to "I thought I could verify this and I could not" is to stop;
#   * an anonymous retry would make the verdict's PROVENANCE non-deterministic —
#     the same publish verified two different ways on two different days,
#     distinguishable only by reading the log closely — and provenance is the
#     property this whole gate exists to have;
#   * it would also be useless exactly where it looks protective: anonymous is
#     the path the token exists to get AWAY from, so the fallback is most likely
#     to meet the very 403 that started this.
# Failing closed costs a red auto-beta, fixable in minutes by fixing
# `permissions:`. A silent downgrade costs a verdict nobody can name.
#
# THE TOKEN NEVER TOUCHES argv OR THE FILESYSTEM. It is fed to curl through
# `--config -` (a config read from stdin), so it is not visible in `ps` to other
# users on a shared machine and it is not left behind in the per-run evidence
# directory, which outlives the run. Nothing here ever prints the value; the log
# says only which mode was used.
#
# 🔴 THE ONE PATH WITH NO VERDICT: A HAND-RUN PUBLISH. Outside Actions there is
# no GITHUB_RUN_ID, hence no round of this commit's own to read, and the owner
# ruled on card rc-538d9ca1ad1d that this WARNS AND PUBLISHES rather than
# refusing. That is a real cost, accepted explicitly: a publish run by hand
# carries NO CI verdict whatsoever. The previous ruling on card rc-ffb4b06ad1d9 —
# "this gate has no exceptions, and no skip switch" — was made when the gate was
# a local CI round, and rc-56fecb4d5aa3 and rc-538d9ca1ad1d supersede it. What
# survives of it is the part that still holds and is still enforced: there is no
# FLAG, no env var and no argument that can turn this gate off. The only way to
# reach the warning path is to not be inside a GitHub Actions run at all, which
# is not something a caller can ask for — and the shipping path (auto-beta) is
# always inside one. Do not add a switch because a caller looked like it wanted
# one; the automated path must keep failing loudly.
#
# WHICH WAY IT FALLS OVER. Every failure mode above aborts BEFORE the build, so
# nothing is built, packaged, uploaded or tagged: breaking this gate makes
# publishing FAIL LOUDLY. The failure shape worth fearing is the silent one —
# publishing anyway while claiming a verdict nobody read — and no path here
# reaches it: the warning path says, in those words, that NO CI VERDICT was
# checked, and never prints anything that reads as green.
# gh_api_get <url> — ONE GET against the Actions API, authenticated when
# $OC_GH_AUTH_TOKEN is non-empty and anonymous when it is not.
#
# `--config -` reads curl's config from STDIN, which is what keeps the credential
# out of the process's argv (visible via `ps` to every other user on the machine)
# AND off disk. The anonymous branch redirects stdin from /dev/null rather than
# leaving it inherited, so the two branches differ in the credential and in
# nothing else.
gh_api_get() {
  if [[ -n "${OC_GH_AUTH_TOKEN:-}" ]]; then
    printf 'header = "Authorization: Bearer %s"\n' "$OC_GH_AUTH_TOKEN" \
      | curl -fsS --config - --max-time 30 \
          -H 'Accept: application/vnd.github+json' "$1"
  else
    curl -fsS --max-time 30 \
      -H 'Accept: application/vnd.github+json' "$1" </dev/null
  fi
}

run_release_ci() {
  local SHA="$1" SHORT="$2"
  local run_id api dir run_json jobs_json rc=0
  # `local` is dynamically scoped in bash, so gh_api_get below sees this without
  # it being a global anybody else can set.
  local OC_GH_AUTH_TOKEN="${GITHUB_TOKEN:-${GH_TOKEN:-}}"

  run_id="${GITHUB_RUN_ID:-}"
  if [[ -z "$run_id" ]]; then
    say "⚠️  CI GATE: NO CI VERDICT WAS CHECKED for $SHORT."
    say "    This publish is not running inside a GitHub Actions run (GITHUB_RUN_ID"
    say "    is unset), so there is no round of this commit's own to read. Nothing"
    say "    was verified about whether this tree passes CI; the release is"
    say "    proceeding anyway (owner ruling, card rc-538d9ca1ad1d)."
    say "    If you want a verdict, publish from the auto-beta workflow instead."
    return 0
  fi

  api="${GITHUB_API_URL:-https://api.github.com}"

  # sha + UTC second + THIS process's pid. The pid is what actually makes it
  # unique (two publishes in the same second are two processes); `mkdir` without
  # -p is the arbiter that turns a collision into a hard stop instead of a run
  # writing its verdict into somebody else's directory. The error is NOT
  # swallowed — a permission/ENOSPC failure must say so rather than be reported
  # as a collision.
  dir="$OUT/ci/$SHORT-$(date -u '+%Y%m%dT%H%M%SZ')-$$"
  mkdir -p "$OUT/ci" \
    || fail_item ci-evidence "could not create $OUT/ci — there is nowhere to record this run's CI verdict."
  mkdir "$dir" \
    || fail_item ci-evidence "could not create the per-run CI evidence directory $dir (it already exists, or the filesystem refused) — refusing to run without somewhere of its own to write the verdict."

  say "CI gate: reading the verdict of GitHub Actions run $run_id for $SHORT"
  say "  evidence: $dir"
  # Which MODE, never the value. A reader has to be able to tell an authenticated
  # verdict from an anonymous one without guessing.
  local authnote
  if [[ -n "$OC_GH_AUTH_TOKEN" ]]; then
    authnote="an authenticated request (GITHUB_TOKEN/GH_TOKEN present)"
    say "  auth: bearer token"
  else
    authnote="an ANONYMOUS request (no GITHUB_TOKEN/GH_TOKEN in the environment; the anonymous quota is 60/hour per IP)"
    say "  auth: none (anonymous)"
  fi

  # --fail turns a 401/403/404/5xx into a non-zero rc instead of a body that
  # would then be parsed as a verdict. A rejected token is NOT retried
  # anonymously — see the ruling in the header above.
  run_json="$(gh_api_get "$api/repos/$GH_REPO/actions/runs/$run_id" 2>/dev/null)" \
    || fail_item release-ci "could not read GitHub Actions run $run_id from $GH_REPO using $authnote — this publish is inside a run whose verdict it cannot read, which is not permission to ship. If the token was rejected, check that auto-beta still declares \`actions: read\` next to \`contents: write\` (a job-level permissions block replaces the set wholesale)."
  printf '%s\n' "$run_json" > "$dir/run.json"

  # ⚠️ NO `filter` parameter. The default (filter=latest) is what drops a re-run's
  # superseded earlier attempt; filter=all would let a stale green attempt certify
  # a red re-run.
  jobs_json="$(gh_api_get "$api/repos/$GH_REPO/actions/runs/$run_id/jobs?per_page=100" 2>/dev/null)" \
    || fail_item release-ci "could not read the job list of GitHub Actions run $run_id using $authnote — without it there is no verdict to believe."
  printf '%s\n' "$jobs_json" > "$dir/jobs.json"

  # ONE pass over both payloads, so "what GitHub said" and "what we require"
  # cannot drift apart across separate ad-hoc extractions.
  WANT_SHA="$SHA" WANT_RUN_ID="$run_id" WANT_JOBS="$REQUIRED_CI_JOBS" \
  RUN_FILE="$dir/run.json" JOBS_FILE="$dir/jobs.json" \
  python3 -c '
import json, os, sys

def fail(item, msg):
    sys.stderr.write("[release] VERIFY-FAILED [%s]: %s\n" % (item, msg))
    raise SystemExit(6)

def load(path, what):
    try:
        with open(path) as fh:
            return json.load(fh)
    except Exception as exc:
        fail("release-ci", "GitHub'"'"'s %s payload is not readable JSON (%s) - an answer that cannot be parsed is not a green verdict." % (what, exc))

run = load(os.environ["RUN_FILE"], "run")
jobs_doc = load(os.environ["JOBS_FILE"], "jobs")

want_run = os.environ["WANT_RUN_ID"]
got_run = str(run.get("id", ""))
if got_run != want_run:
    fail("ci-run-binding", "asked GitHub about run %s and it answered about run %r - a verdict for a run nobody asked about is not this commit\x27s verdict." % (want_run, got_run))

want_sha = os.environ["WANT_SHA"]
head = run.get("head_sha") or ""
if head != want_sha:
    fail("ci-run-binding", "GitHub Actions run %s was for commit %s, but this publish is shipping %s. A green round for ANOTHER commit says nothing about the tree about to be built." % (want_run, head or "<none>", want_sha))

jobs = jobs_doc.get("jobs")
if not isinstance(jobs, list):
    fail("release-ci", "the jobs payload for run %s carries no job list - there is nothing to read a verdict from." % want_run)
total = jobs_doc.get("total_count")
if isinstance(total, int) and total > len(jobs):
    fail("release-ci", "run %s reports total_count=%d but this page returned %d jobs - a truncated roll-call cannot tell a missing PAGE from a missing JOB." % (want_run, total, len(jobs)))

by_name = {}
for j in jobs:
    by_name[j.get("name")] = j
want = [n for n in os.environ["WANT_JOBS"].splitlines() if n.strip()]
missing = [n for n in want if n not in by_name]
if missing:
    fail("release-ci", "run %s has NO ENTRY for required gate job(s): %s. A job that never ran produces no entry at all, so \"everything visible is green\" is also true of a round that never checked it. Saw: %s." % (want_run, ", ".join(missing), ", ".join(sorted(str(k) for k in by_name)) or "nothing"))
notgreen = [(n, by_name[n].get("conclusion")) for n in want if by_name[n].get("conclusion") != "success"]
if notgreen:
    fail("release-ci", "run %s did not go green on: %s. The required conclusion is exactly \"success\" - skipped, cancelled, action_required, timed_out, neutral and a still-running null are all NOT a pass." % (want_run, ", ".join("%s=%r" % (n, c) for n, c in notgreen)))

print("[release]   %d/%d required gate jobs succeeded on run %s (head_sha %s)"
      % (len(want), len(want), want_run, head), file=sys.stderr)
' || rc=$?
  [[ "$rc" == "0" ]] || exit "$rc"

  say "  CI verdict accepted for $SHORT (GitHub run $run_id, head_sha bound to --target, all required jobs success)"
}

# verify_artifacts <tag> <sha> <short> <name> — everything checkable locally,
# before a single byte is uploaded.
verify_artifacts() {
  local TAG="$1" SHA="$2" SHORT="$3" NAME="$4"
  say "verify artifacts (pre-upload)"

  local f
  while IFS= read -r f; do
    [[ -f "$OUT/$f" ]] || fail_item artifact-present "expected artifact $f is missing from $OUT."
    [[ -s "$OUT/$f" ]] || fail_item artifact-nonempty "artifact $f is empty."
  done < <(asset_names "$TAG")

  # The tarball's member list, EXACTLY. A tarball missing ocwarden — or one that
  # quietly grew a stray file — is a broken install, not a cosmetic issue.
  local want_members got_members
  want_members="$(printf '%s\n' LICENSE README.md install.sh ocagent ocserverd ocwarden officraft)"
  got_members="$(tar -tzf "$OUT/$NAME.tar.gz" \
    | sed -e "s|^$NAME/||" -e '/^$/d' | LC_ALL=C sort)"
  [[ "$got_members" == "$want_members" ]] || fail_item tarball-members \
    "tarball member list is wrong. want: $(echo "$want_members" | tr '\n' ' ')| got: $(echo "$got_members" | tr '\n' ' ')"

  # The three binaries must be native arm64 mach-o, and ocserverd must carry the
  # version + commit we asked for. `go version -m` reports the LINKER FLAGS the
  # binary was built with, so this reads the stamp itself rather than hoping the
  # tag string appears somewhere in the bytes (it appears in README.md too, so a
  # grep over the tarball would "pass" on an unstamped binary).
  local vdir
  vdir="$(mktemp -d -t oc-release-verify.XXXXXX)"
  tar -C "$vdir" -xzf "$OUT/$NAME.tar.gz"
  # Match each token INDEPENDENTLY, not as an ordered glob. `file -b` on a Go
  # arm64 binary says exactly "Mach-O 64-bit executable arm64" — architecture
  # LAST — so the ordered pattern this replaced (Mach-O…arm64…executable) could
  # never match any real artifact, and every publish died here. Ordering in
  # file(1)'s prose is not a contract; the presence of the three tokens is what
  # this check is actually about.
  local b desc
  for b in ocserverd ocwarden ocagent officraft; do
    desc="$(file -b "$vdir/$NAME/$b")"
    [[ "$desc" == *"Mach-O"* && "$desc" == *"arm64"* && "$desc" == *"executable"* ]] \
      || fail_item artifact-arch "$b is not a darwin/arm64 Mach-O executable (file says: $desc)"
  done
  local ldflags
  ldflags="$(go version -m "$vdir/$NAME/ocserverd" 2>/dev/null | grep -F -- '-ldflags' || true)"
  [[ -n "$ldflags" ]] \
    || fail_item version-stamp "could not read ocserverd's linker flags (go version -m returned no -ldflags line) — the embedded version identity is unverifiable."
  [[ "$ldflags" == *"-X main.appVersion=$TAG"* ]] \
    || fail_item version-stamp "ocserverd was NOT stamped with appVersion=$TAG (its -ldflags: $ldflags) — /api/version would misreport the release."
  [[ "$ldflags" == *"-X main.buildSHA=$SHORT"* ]] \
    || fail_item version-stamp "ocserverd was NOT stamped with buildSHA=$SHORT (its -ldflags: $ldflags) — the artifact cannot prove which commit it came from."

  # 🔴 AND THE ocagent, WHICH IS THE BINARY THAT CANNOT BE ASKED LATER (T-8f7d).
  # A listener process holds the image it started with, so an unstamped ocagent
  # is not a cosmetic gap: every connection line it ever prints omits the
  # [agent …] segment, and that is BYTE-IDENTICAL to a dev build behaving
  # correctly. Nothing downstream can tell them apart, which is why it has to be
  # caught here, on the artifact, before it is published.
  # ⚠️ THIS IS THE SHIPPED COPY, NOT A REBUILD. It comes out of the tarball, which
  # was copied from server/ocserverd/bindist/ocagent — the same file `go:embed
  # all:bindist` baked into ocserverd, so this pins the output of that embed and
  # not merely the input to it. bin/tests/agent-build-sha-guard.sh case 7 asks a
  # FRESHLY BUILT ocagent for its version, which proves the build line stamps but
  # says nothing about what ended up inside the artifact.
  # ⚠️ NOT ADDED TO THAT GUARD AS WELL, AND THE REASON IS NOT COST. Measured: an
  # ocserverd builds in 5.5s cold / 0.8s warm, so the guard could afford one. What
  # it could not do is build the RIGHT one — go:embed needs webdist/, seedsdist/
  # and docsdist/ staged, and a guard that fakes them (an empty webdist is what it
  # takes) would be reading an ocserverd nobody ships, then generalising from it.
  # That is the same move — one tree shape, one artifact, treated as all of them —
  # that made the earlier checks in that guard decoration. Here the bytes under
  # inspection ARE the ones being published. Release is the last moment this can
  # still be wrong, and the first moment a real ocserverd exists.
  # `go version -m` reads the LINKER FLAGS, not the bytes: `ocagent version` would
  # need the artifact to be executable on this host, and a grep for the sha would
  # match the auto-embedded vcs.revision (cli/ocagent has no -buildvcs=false).
  # ⚠️ $SHORT and the stamp must abbreviate to the SAME LENGTH, and they do only
  # because $STAGE is `git worktree add`-ed from $SRC and therefore shares its
  # object database — git picks the abbreviation from the object count, and a
  # clone of the same commit really does abbreviate differently (measured: 7 vs 8
  # characters for the same sha). If $STAGE ever becomes a clone, this comparison
  # starts failing on a correctly stamped binary.
  local agent_ldflags
  agent_ldflags="$(go version -m "$vdir/$NAME/ocagent" 2>/dev/null | grep -F -- '-ldflags' || true)"
  [[ -n "$agent_ldflags" ]] \
    || fail_item agent-stamp "could not read the packaged ocagent's linker flags (go version -m returned no -ldflags line) — cannot prove the listeners this release installs will be able to name their own build."
  [[ "$agent_ldflags" == *"-X main.buildSHA=$SHORT"* ]] \
    || fail_item agent-stamp "the packaged ocagent was NOT stamped with buildSHA=$SHORT (its -ldflags: $agent_ldflags). Every listener installed from this release prints a connection line with no [agent …] segment — indistinguishable from a dev build doing the right thing — so 'ship it and watch the fleet' returns a false negative for the whole life of every long-lived agent."

  rm -rf "$vdir"
  say "  ocserverd stamp OK: appVersion=$TAG buildSHA=$SHORT"
  say "  packaged ocagent stamp OK: buildSHA=$SHORT"

  # checksums.txt must actually check out, and must cover exactly the two files
  # the install one-liner verifies. A checksums file that lists one entry — or
  # none — is how install.sh's sha256 step starts silently passing on nothing.
  local lines
  lines="$(awk 'NF' "$OUT/checksums.txt" | wc -l | tr -d '[:space:]')"
  [[ "$lines" == "2" ]] \
    || fail_item checksums-scope "checksums.txt has $lines entries; expected exactly 2 ($NAME.tar.gz + install.sh)."
  ( cd "$OUT" && shasum -a 256 -c checksums.txt >/dev/null 2>&1 ) \
    || fail_item checksums-match "shasum -c checksums.txt FAILED — the published digests do not match the published files."
  say "  checksums OK (2 entries, shasum -c clean)"
  say "artifacts verified for $TAG @ $SHORT"
}

# verify_stored_release <tag> <expected-target-or-empty> <prerelease|final> <expected-latest-or-empty: true|false>
#
# expected-latest: pass "true" or "false" to ENFORCE the "Latest" designation
# against GitHub's stored value (fatal on mismatch, item "release-latest");
# pass "" to skip enforcement and just read it back. Output line 2 is always
# isLatest, whatever was passed, so callers that don't enforce can still
# compare BEFORE/AFTER.
#
# MEASURED (2026-08-28, gh 2.93.0): `gh release view --json` has NO `isLatest`
# field — asking for it fails with "Unknown JSON field". `isLatest` only exists
# on `gh release list --json`. Rather than list-and-filter (which silently
# misses the tag if it has scrolled past whatever --limit a caller picked),
# this reads GitHub's own `GET /repos/{repo}/releases/latest` — the endpoint
# that defines "latest" — and compares its tag_name to ours. A 404 there means
# "no release is latest", which is itself a valid (not-latest) answer.
#
# THE PAYLOAD SHAPE IS MEASURED, NOT ASSUMED (2026-07-26). Everything below keys
# off `gh release view --json ...`, so it depends on field names AND on the exact
# value `"uploaded"`. Assuming an external tool's output format is precisely how
# the arch check in verify_artifacts shipped broken — it pattern-matched `file -b`
# in an order `file` never emits, so every publish died there. Measured instead,
# against pkyosx/OffiCraft v0.5.38:
#
#   $ gh release view v0.5.38 --json assets,isDraft,isPrerelease,targetCommitish
#   isDraft False | isPrerelease True | targetCommitish fb89a69aad8c
#   {'name': 'checksums.txt',                          'state': 'uploaded', 'size': 181}
#   {'name': 'install.sh',                             'state': 'uploaded', 'size': 70730}
#   {'name': 'officraft-v0.5.38-darwin-arm64.tar.gz',  'state': 'uploaded', 'size': 16842394}
#
# So: the asset sub-fields `name`/`state`/`size` DO exist, `state` is the literal
# string "uploaded" for a healthy asset, and `size` is a non-zero integer. If a
# future gh changes any of that, the read-back fails CLOSED (it will name
# asset-uploaded) rather than passing on a field it can no longer see — but
# re-measure before "fixing" it.
#
#   Asks GitHub what it stored and enforces every read-back DoD item. On success
#   it prints, on STDOUT: line 1 = targetCommitish, line 2 = isLatest (True/False),
#   lines 3+ = the asset fingerprint (name<TAB>size, sorted). Everything
#   human-readable goes to stderr so a caller's capture stays parseable.
verify_stored_release() {
  local TAG="$1" WANT_TARGET="$2" KIND="$3" WANT_LATEST="${4:-}"
  echo "[release] read back what GitHub stored for $TAG" >&2

  local json
  json="$(gh release view "$TAG" --repo "$GH_REPO" \
            --json tagName,isDraft,isPrerelease,targetCommitish,assets 2>/dev/null)" \
    || fail_item release-exists "gh release view $TAG failed — the release does not exist or is not readable."
  [[ -n "$json" ]] \
    || fail_item release-exists "gh release view $TAG returned nothing."

  # "latest" is not on that payload (see the note above) — ask the endpoint
  # that actually defines it and compare by tag, INSIDE the one python pass
  # below (not with `gh api --jq`, which relies on gh's own jq being what runs
  # — the hermetic test shim has no real gh/jq to defer to, so the raw body is
  # parsed the same way the release-view payload already is). `|| true` on a
  # 404 (no release is latest yet, or the repo has none) leaves the body empty,
  # which parses to "no tag" and correctly reads as "$TAG is not latest" below
  # rather than aborting the whole read-back.
  #
  # RETRY-WITH-BACKOFF, same shape as settle_station (owner ruling,
  # 2026-08-28): GitHub does not document --latest as visible on
  # /releases/latest the instant `gh release edit` returns, so a single read
  # right after the flip can catch it mid-propagation and report a false
  # [release-latest] failure on a promote that actually worked — training
  # people to distrust a real red is its own failure mode, not a safer one.
  # Only retried when a caller is actually ENFORCING isLatest (WANT_LATEST
  # non-empty) — an unenforced, purely informational read (WANT_LATEST="",
  # e.g. publish's pre-upload / promote's pre-flip calls) stays exactly one
  # call, same as before this existed. Still fails CLOSED: exhausting
  # LATEST_TRIES with no match falls through to the same VERIFY-FAILED
  # [release-latest] as ever, from the python pass below.
  local latest_json="" latest_tag_now="" li
  for (( li = 1; li <= LATEST_TRIES; li++ )); do
    latest_json="$(gh api "repos/$GH_REPO/releases/latest" 2>/dev/null || true)"
    [[ -n "$WANT_LATEST" ]] || break
    latest_tag_now="$(python3 -c '
import json, sys
try:
    print(json.loads(sys.stdin.read() or "null").get("tag_name") or "")
except Exception:
    print("")
' <<<"$latest_json" 2>/dev/null || true)"
    if [[ "$WANT_LATEST" == "true"  && "$latest_tag_now" == "$TAG" ]] || \
       [[ "$WANT_LATEST" == "false" && "$latest_tag_now" != "$TAG" ]]; then
      break
    fi
    [[ "$li" == "$LATEST_TRIES" ]] || sleep "$LATEST_SLEEP"
  done

  # ONE pass over the payload: it either prints the two blocks this function
  # contracts to return, or prints a VERIFY-FAILED line and exits 6. Keeping it
  # in one place stops "what GitHub said" and "what we require" from drifting
  # apart across four separate ad-hoc extractions.
  local parsed rc=0
  parsed="$(WANT_TAG="$TAG" WANT_TARGET="$WANT_TARGET" WANT_KIND="$KIND" \
            WANT_LATEST="$WANT_LATEST" WANT_REPO="$GH_REPO" \
            LATEST_JSON="$latest_json" \
            WANT_ASSETS="$(asset_names "$TAG")" \
            python3 -c '
import json, os, sys

def fail(item, msg):
    sys.stderr.write("[release] VERIFY-FAILED [%s]: %s\n" % (item, msg))
    raise SystemExit(6)

rel = json.load(sys.stdin)
tag = os.environ["WANT_TAG"]
if rel.get("tagName") != tag:
    fail("release-tag", "GitHub returned tagName %r, asked for %r." % (rel.get("tagName"), tag))
if rel.get("isDraft") is not False:
    fail("release-draft", "%s is a DRAFT (isDraft=%r) - a draft is invisible to every consumer of GitHub Releases, including the in-product update check." % (tag, rel.get("isDraft")))
want_pre = os.environ["WANT_KIND"] == "prerelease"
if bool(rel.get("isPrerelease")) is not want_pre:
    fail("release-channel", "%s isPrerelease=%r but this step requires isPrerelease=%r." % (tag, rel.get("isPrerelease"), want_pre))
target = rel.get("targetCommitish") or ""
if not target:
    fail("release-target", "%s has an EMPTY targetCommitish - the release cannot say which commit it was cut from." % tag)
want_target = os.environ["WANT_TARGET"]
if want_target and target != want_target:
    fail("release-target", "%s targetCommitish is %s, expected %s." % (tag, target, want_target))

actual_latest_tag = None
latest_raw = os.environ.get("LATEST_JSON") or ""
if latest_raw.strip():
    try:
        actual_latest_tag = json.loads(latest_raw).get("tag_name")
    except (ValueError, AttributeError):
        actual_latest_tag = None
is_latest = actual_latest_tag == tag
want_latest = os.environ["WANT_LATEST"]
if want_latest:
    want_latest_bool = want_latest == "true"
    if is_latest is not want_latest_bool:
        fail("release-latest", "%s isLatest=%r (repos/%s/releases/latest -> %r), expected %r. Next step: gh release edit %s --repo %s --latest=%s" % (tag, is_latest, os.environ["WANT_REPO"], actual_latest_tag, want_latest_bool, tag, os.environ["WANT_REPO"], str(want_latest_bool).lower()))

by_name = {}
for a in (rel.get("assets") or []):
    by_name[a.get("name")] = a
want = [n for n in os.environ["WANT_ASSETS"].splitlines() if n]
for n in want:
    if n not in by_name:
        fail("asset-present", "%s is missing asset %r (has: %s) - a half-populated release 404s the documented install command." % (tag, n, ", ".join(sorted(str(k) for k in by_name)) or "none"))
    state = by_name[n].get("state")
    if state != "uploaded":
        fail("asset-uploaded", "%s asset %r has state=%r, not \"uploaded\" - the release exists but that file is not actually downloadable." % (tag, n, state))
    if not by_name[n].get("size"):
        fail("asset-uploaded", "%s asset %r reports size=%r - a zero-byte asset is not a published file." % (tag, n, by_name[n].get("size")))
extra = sorted(str(k) for k in set(by_name) - set(want))
if extra:
    fail("asset-extra", "%s carries unexpected asset(s) %s - the published set must be exactly %s." % (tag, ", ".join(extra), ", ".join(want)))

print(target)
print(is_latest)
for n in sorted(want):
    print("%s\t%s" % (n, by_name[n].get("size")))
' <<<"$json")" || rc=$?
  [[ "$rc" == "0" ]] || exit "$rc"

  local n_assets
  n_assets="$(printf '%s\n' "$parsed" | sed -n '3,$p' | grep -c . || true)"
  local latest_line
  latest_line="$(printf '%s\n' "$parsed" | sed -n '2p')"
  echo "[release]   stored release OK: not a draft, channel=$KIND, isLatest=$latest_line, $n_assets assets all uploaded" >&2
  printf '%s\n' "$parsed"
}

# settle_station <sha> <short> — the last DoD item: a release is not "done" until
# the running station is actually on it. /api/version is public and git_sha is the
# field to reconcile against (the version field is 0.0.0 on a self-build). Health
# is checked too, because a server that answers /api/version from a half-booted
# state is not a successful upgrade.
#
# THIS FUNCTION ONLY OBSERVES; IT NEVER PUSHES. Nothing here (and nothing anywhere
# in publish) tells the station to upgrade. The station's own auto_update picks the
# new release up — including a PRERELEASE — and it took about 2-3 minutes when this
# was measured on 2026-07-26 (v0.5.38, isPrerelease=true, git_sha reconciled). The
# default budget below is 60 x 5s = 5 minutes, i.e. roughly double the measured
# latency. If auto_update is ever turned off on the owner's account this step
# starts failing while the release itself is perfectly fine, so the timeout has to
# say WHICH thing did not happen — a bare "publish failed" would send the next
# person hunting the artifacts instead of the account setting.
settle_station() {
  local SHA="$1" SHORT="$2" i seen=""
  say "settle: waiting for $SITE to report git_sha matching $SHORT (up to $((SETTLE_TRIES * SETTLE_SLEEP))s)"
  for (( i = 1; i <= SETTLE_TRIES; i++ )); do
    seen="$(curl -fsS --max-time 10 "$SITE/api/version" 2>/dev/null \
             | python3 -c 'import json,sys
try: print(json.load(sys.stdin).get("git_sha") or "")
except Exception: print("")' 2>/dev/null || true)"
    # A short sha is a PREFIX of the full one; require a real prefix of at least
    # 7 chars so an empty or truncated answer can never satisfy this.
    if [[ -n "$seen" && "${#seen}" -ge 7 && "$SHA" == "$seen"* ]]; then
      say "  /api/version git_sha=$seen matches the target commit"
      curl -fsS --max-time 10 "$SITE/api/health" >/dev/null 2>&1 \
        || fail_item station-health "$SITE is on the target commit but GET /api/health did not answer ok."
      say "  /api/health ok"
      return 0
    fi
    sleep "$SETTLE_SLEEP"
  done
  fail_item station-settle "the station at $SITE did not upgrade to $SHORT within $((SETTLE_TRIES * SETTLE_SLEEP))s (its /api/version git_sha last read: '${seen:-<none>}'). THIS IS THE ONLY UNMET ITEM: the assets uploaded and the stored release read back correct, so the tag, the artifacts and the target commit are all fine — what did not happen is the station moving onto them. publish never pushes an upgrade; it waits for the station's own auto_update to pick the release up (measured at ~2-3 min). Check that auto_update is still enabled on the owner's account before suspecting the release."
}

write_package_readme() { # write_package_readme <path> <tag> <short-sha>
  local path="$1" TAG="$2" HEAD_SHA="$3"
  cat > "$path" <<EOF
# OffiCraft $TAG (darwin-arm64)

Run your own AI staff office on a Mac. This package contains everything —
no Go/Node toolchain needed.

## Install (one command)

\`\`\`
./install.sh
\`\`\`

Installs to \`~/.officraft/bin\`, creates/migrates the database at
\`~/.officraft/server/data/officraft.db\`, then registers and starts the
launchd job \`com.officraft.serve\` (starts at login, restarts on crash; logs
to \`~/.officraft/server/log/serve.log\`). It does NOT hold your terminal —
pass \`--foreground\` if you want that instead. The installer then prints a
one-time setup link (\`http://127.0.0.1:7755/?code=…\`) — open it to set your
owner password.

Once that password is set the server finishes setup ITSELF: it installs this
machine's warden and brings your assistant online, so you land on a working
studio rather than an empty cockpit. That needs \`tmux\` plus a working,
LOGGED-IN agent runtime — \`claude\` or \`codex\` — on this machine; if that is
missing the setup fails loudly and the cockpit shows exactly why, instead of
installing a warden that would refuse every spawn. Whichever runtimes are
found are recorded in the service config, so members of either kind can start.
If a runtime lives behind a version manager (asdf/nvm/volta), re-run with
\`OC_CLAUDE_BIN=/absolute/path/to/claude\` or
\`OC_CODEX_BIN=/absolute/path/to/codex\`.

Already have OffiCraft installed? The installer detects it, warns, and asks
before overwriting (\`--force\` skips the prompt in scripts). If a service is
LIVE it refuses outright — restarting it drops every connected cockpit and
agent — until you also pass \`--restart-live\`.

Stop/start the service with
\`launchctl bootout|bootstrap gui/\$(id -u) ~/Library/LaunchAgents/com.officraft.serve.plist\`.

## Contents

- \`ocserverd\` — the server (web app, seeds and agent binaries embedded)
- \`ocwarden\`, \`ocagent\` — fleet CLI binaries (also served by ocserverd)
- \`officraft\` — the warden's fixed launchd identity; \`install.sh\` needs it
  beside itself and refuses without it
- \`install.sh\` — the installer above
- \`LICENSE\` — MIT

Build identity: tag $TAG, git $HEAD_SHA. Verify: \`/api/version\` reports
\`"version":"$TAG"\`.
EOF
}

# ═══════════════════════════════════════════════════════════════════════════
# dispatch — only when EXECUTED. `source bin/release` defines the functions and
# runs nothing, which is how bin/tests/release-guard.sh unit-tests the real
# verification helpers instead of a re-implementation of them.
# ═══════════════════════════════════════════════════════════════════════════
if [[ "${BASH_SOURCE[0]}" != "${0}" ]]; then
  return 0
fi

SUB="${1:-}"
shift || true
case "$SUB" in
  publish) cmd_publish "$@" ;;
  promote) cmd_promote "$@" ;;
  ""|-h|--help|help) usage ;;
  # LEGACY `bin/release <tag>` — refuse LOUDLY, never silently reinterpret.
  # The old command built from whatever the current worktree's HEAD was and only
  # PRINTED an upload command. Accepting `bin/release v0.1.0` as
  # `publish --beta v0.1.0 --target HEAD` would keep the words and change the
  # deed: it would now really upload, really create a prerelease, and really pick
  # a commit the operator never named. So it exits non-zero with the exact
  # replacement command instead.
  v[0-9]*)
    cat >&2 <<EOM
[release] REMOVED: 'bin/release $SUB' (the old build-and-print-a-command form).
[release]
[release] It built from the CURRENT worktree HEAD and only printed a
[release] 'gh release create' line for you to paste - no artifact verification,
[release] no read-back, no check that the station ever moved. Publishing is now
[release] one command that owns the whole arc:
[release]
[release]   bin/release publish --beta $SUB --target <sha>
[release]
[release] Rehearse it first with --dry-run (builds + verifies, uploads nothing):
[release]
[release]   bin/release publish --beta $SUB --target <sha> --dry-run
[release]
[release] Then, once the beta is proven, promote it WITHOUT rebuilding:
[release]
[release]   bin/release promote $SUB
EOM
    exit 2 ;;
  *) echo "[release] unknown subcommand: $SUB" >&2; usage ;;
esac
