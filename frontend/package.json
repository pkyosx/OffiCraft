{
  "name": "officraft-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json && tsc --noEmit -p tsconfig.guards.json",
    "gen:api": "openapi-typescript ../spec/openapi.json -o src/api/generated/schema.ts",
    "gen:tokens": "node scripts/gen-theme-tokens.mjs",
    "gen:fonts": "node scripts/gen-theme-fonts.mjs",
    "gen:msgkeys": "node scripts/gen-message-keys.mjs",
    "lint:tokens": "node scripts/check-css-tokens.mjs",
    "lint:token-roles": "node scripts/check-token-roles.mjs",
    "lint:async-landing": "node scripts/check-async-landing-points.mjs",
    "lint:chat-area-key": "node scripts/check-chat-area-key.mjs",
    "test": "vitest run",
    "test:ct": "playwright test -c playwright-ct.config.ts && npm run test:paint",
    "build:paint-guard": "VITE_USE_MOCK=false vite build --logLevel warn",
    "test:paint": "npm run build:paint-guard && playwright test -c playwright-paint.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0",
    "qrcode-generator": "2.0.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "1.61.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "jsdom": "^25.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  }
}
